VITE_FIREBASE_API_KEY=sua_api_key
VITE_FIREBASE_AUTH_DOMAIN=seu_projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu_projeto
VITE_FIREBASE_STORAGE_BUCKET=seu_projeto.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=seu_sender_id
VITE_FIREBASE_APP_ID=seu_app_id
VITE_FIREBASE_MEASUREMENT_ID=seu_measurement_id

# Chave de push da Web (Firebase > Configuracoes do projeto > Cloud Messaging)
VITE_FIREBASE_VAPID_KEY=sua_chave_vapid

# Somente no servidor (Vercel), NAO precisa no .env local:
# FIREBASE_SERVICE_ACCOUNT = json da conta de servico (ja existe, usado pelo webhook)
# LEMBRETES_SECRET         = senha que o agendador usa para chamar /api/enviar-lembretes
